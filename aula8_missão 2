        "import requests\n",
        "\n",
        "def buscar_cep():\n",
        "    # URL da API ViaCEP com um erro intencional\n",
        "    # A URL correta é \"https://viacep.com.br/ws/{}/json/\"\n",
        "    base_url = \"https://viacep.com.br/ws_erro/{}/json/\" # Intencionalmente errado para demonstrar tratamento de erro\n",
        "\n",
        "    print(\"--- Consulta de CEP ViaCEP ---\")\n",
        "    print(\"Digite 'sair' a qualquer momento para encerrar.\")\n",
        "\n",
        "    while True:\n",
        "        cep = input(\"\\nDigite o CEP (apenas números): \")\n",
        "\n",
        "        if cep.lower() == 'sair':\n",
        "            print(\"Encerrando consulta.\")\n",
        "            break\n",
        "\n",
        "        # Validação básica do CEP\n",
        "        if not cep.isdigit() or len(cep) != 8:\n",
        "            print(\"CEP inválido. Por favor, digite um CEP com 8 dígitos numéricos.\")\n",
        "            continue\n",
        "\n",
        "        url = base_url.format(cep)\n",
        "\n",
        "        try:\n",
        "            print(f\"Buscando informações para o CEP: {cep}...\")\n",
        "            response = requests.get(url, timeout=5) # Adiciona timeout para evitar esperas infinitas\n",
        "            response.raise_for_status() # Lança um HTTPError para respostas de status 4xx/5xx\n",
        "\n",
        "            data = response.json()\n",
        "\n",
        "            # Verifica se a API retornou um erro específico (para CEP não encontrado, por exemplo)\n",
        "            if 'erro' in data and data['erro']:\n",
        "                print(f\"CEP '{cep}' não encontrado ou inválido.\")\n",
        "            else:\n",
        "                print(\"\\n--- Informações do Endereço ---\")\n",
        "                print(f\"CEP:        {data.get('cep', 'N/A')}\")\n",
        "                print(f\"Logradouro: {data.get('logradouro', 'N/A')}\")\n",
        "                print(f\"Bairro:     {data.get('bairro', 'N/A')}\")\n",
        "                print(f\"Cidade:     {data.get('localidade', 'N/A')}\")\n",
        "                print(f\"Estado:     {data.get('uf', 'N/A')}\")\n",
        "                print(\"---------------------------------\")\n",
        "\n",
        "        except requests.exceptions.ConnectionError:\n",
        "            print(\"Erro de conexão: Não foi possível conectar ao servidor da ViaCEP. Verifique sua conexão com a internet.\")\n",
        "        except requests.exceptions.Timeout:\n",
        "            print(\"Erro de tempo limite: A requisição demorou muito para responder.\")\n",
        "        except requests.exceptions.HTTPError as http_err:\n",
        "            print(f\"Erro HTTP: {http_err} - Ocorreu um problema ao acessar a API. Este erro é intencional devido à URL incorreta.\\nPor favor, corrija a 'base_url' dentro da função para 'https://viacep.com.br/ws/{{}}/json/' e execute novamente.\")\n",
        "        except requests.exceptions.RequestException as req_err:\n",
        "            print(f\"Erro na requisição: {req_err} - Um erro inesperado ocorreu durante a requisição.\")\n",
        "        except ValueError:\n",
        "            print(\"Erro ao decodificar a resposta JSON. A API pode ter retornado um formato inesperado.\")\n",
        "        except Exception as e:\n",
        "            print(f\"Ocorreu um erro inesperado: {e}\")\n",
        "\n",
        "# Chama a função principal\n",
        "buscar_cep()\n",
        "\n",
        "# --- Explicação do Código e Correção do Erro Intencional ---\n",
        "#\n",
        "# O script implementa uma função `buscar_cep()` que interage com a API pública ViaCEP.\n",
        "#\n",
        "# 1.  **Importação**: A biblioteca `requests` é importada para fazer requisições HTTP.\n",
        "# 2.  **URL da API (Erro Intencional)**: A `base_url` foi definida inicialmente como\n",
        "#     `\"https://viacep.com.br/ws_erro/{}/json/\"`. O segmento `_erro` foi adicionado\n",
        "#     para simular um erro de URL, que resultará em um `HTTPError` (código 404 - Not Found)\n",
        "#     quando o script tenta acessar a API.\n",
        "# 3.  **Loop de Interação**: Um loop `while True` permite que o usuário consulte múltiplos\n",
        "#     CEPs ou digite 'sair' para encerrar o programa.\n",
        "# 4.  **Validação de CEP**: Antes de fazer a requisição, o CEP digitado é validado\n",
        "#     para garantir que possui 8 dígitos numéricos.\n",
        "# 5.  **Requisição HTTP (`try/except`)**:\n",
        "#     *   `requests.get(url, timeout=5)`: Faz a requisição HTTP à API com um tempo limite de 5 segundos.\n",
        "#     *   `response.raise_for_status()`: Esta linha é crucial. Ela verifica o código de status da\n",
        "#         resposta HTTP. Se for um código de erro (4xx ou 5xx), ela levanta uma exceção `HTTPError`.\n",
        "#     *   `response.json()`: Tenta converter a resposta da API (esperada em formato JSON) em um\n",
        "#         dicionário Python.\n",
        "#     *   **Tratamento de Erros**: Diferentes blocos `except` capturam erros específicos:\n",
        "#         *   `requests.exceptions.ConnectionError`: Problemas na conexão de rede (ex: sem internet).\n",
        "#         *   `requests.exceptions.Timeout`: A requisição excedeu o tempo limite.\n",
        "#         *   `requests.exceptions.HTTPError`: Erros de status HTTP (ex: 404, 500).\n",
        "#         *   `requests.exceptions.RequestException`: Um erro genérico que cobre outros problemas de requisição.\n",
        "#         *   `ValueError`: Se a resposta da API não for um JSON válido.\n",
        "#         *   `Exception`: Captura quaisquer outros erros inesperados.\n",
        "#     *   **Tratamento de CEP Não Encontrado**: A API ViaCEP retorna um JSON com `{\"erro\": true}`\n",
        "#         quando um CEP é inválido ou não encontrado. O script verifica essa chave no dicionário `data`.\n",
        "# 6.  **Exibição de Dados**: Se a requisição for bem-sucedida e o CEP for encontrado,\n",
        "#     as informações do endereço (`logradouro`, `bairro`, `localidade`, `uf`) são\n",
        "#     extraídas do dicionário JSON e exibidas de forma formatada. O método `data.get('chave', 'N/A')`\n",
        "#     é usado para evitar `KeyError` caso alguma chave esperada esteja ausente na resposta da API.\n",
        "#\n",
        "# **Para corrigir o erro intencional na URL e testar com sucesso:**\n",
        "# Encontre a linha `base_url = \"https://viacep.com.br/ws_erro/{}/json/\"` dentro da função `buscar_cep()`\n",
        "# e altere-a para a URL correta:\n",
        "# `base_url = \"https://viacep.com.br/ws/{}/json/\"`\n",
        "# Após essa correção, execute a célula novamente para ver o script funcionando corretamente."
