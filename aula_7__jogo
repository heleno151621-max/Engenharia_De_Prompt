        "import random\n",
        "\n",
        "def verificar_letra(letra, palavra_secreta, letras_corretas):\n",
        "    \"\"\"\n",
        "    Função específica para verificar se a letra existe na palavra\n",
        "    e atualizar a lista de letras encontradas.\n",
        "    \"\"\"\n",
        "    if letra in palavra_secreta:\n",
        "        letras_corretas.add(letra)\n",
        "        return True\n",
        "    return False\n",
        "\n",
        "def exibir_tabuleiro(palavra_secreta, letras_corretas, tentativas_restantes):\n",
        "    \"\"\"Exibe o estado atual da palavra e tentativas.\"\"\"\n",
        "    # Performance: List comprehension para join rápido\n",
        "    status = [letra if letra in letras_corretas else \"_\" for letra in palavra_secreta]\n",
        "    print(f\"\\nPalavra: {' '.join(status)}\")\n",
        "    print(f\"Tentativas restantes: {tentativas_restantes}\")\n",
        "\n",
        "def jogar_forca():\n",
        "    # Configurações iniciais\n",
        "    palavras = [\"PYTHON\", \"DESENVOLVEDOR\", \"ALGORITMO\", \"MODULAR\", \"COLAB\"]\n",
        "    palavra_secreta = random.choice(palavras).upper()\n",
        "\n",
        "    # Performance: Pré-calcular o set de letras únicas para comparação de vitória ultra-rápida\n",
        "    letras_unicas_na_palavra = set(palavra_secreta)\n",
        "    letras_corretas = set()\n",
        "    letras_tentadas = set()\n",
        "    tentativas_restantes = 6\n",
        "\n",
        "    print(\"--- JOGO DA FORCA (MODO SENIOR REFATORADO) ---\")\n",
        "\n",
        "    while tentativas_restantes > 0:\n",
        "        exibir_tabuleiro(palavra_secreta, letras_corretas, tentativas_restantes)\n",
        "\n",
        "        palpite = input(\"Digite uma letra: \").upper().strip()\n",
        "\n",
        "        # Early return/continue para evitar aninhamento desnecessário\n",
        "        if not palpite or len(palpite) > 1 or not palpite.isalpha():\n",
        "            print(\"Por favor, digite apenas uma única letra válida.\")\n",
        "            continue\n",
        "\n",
        "        if palpite in letras_tentadas:\n",
        "            print(f\"Você já tentou a letra '{palpite}'. Tente outra.\")\n",
        "            continue\n",
        "\n",
        "        letras_tentadas.add(palpite)\n",
        "\n",
        "        # Lógica modular de verificação\n",
        "        if verificar_letra(palpite, palavra_secreta, letras_corretas):\n",
        "            print(f\"Boa! A letra '{palpite}' faz parte da palavra.\")\n",
        "\n",
        "            # Performance: Verificação de vitória via comparação de sets (O(1) ou O(n) pequeno)\n",
        "            # Evita o overhead de um loop 'all()' a cada jogada correta\n",
        "            if letras_unicas_na_palavra.issubset(letras_corretas):\n",
        "                print(f\"\\nParabéns! Você venceu. A palavra era: {palavra_secreta}\")\n",
        "                return\n",
        "        else:\n",
        "            tentativas_restantes -= 1\n",
        "            print(f\"Ops! A letra '{palpite}' não existe na palavra.\")\n",
        "\n",
        "    print(f\"\\nGame Over! Você perdeu. A palavra era: {palavra_secreta}\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    jogar_forca()"
